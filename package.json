{
  "name": "capacitor-native-tab",
  "version": "1.0.4",
  "description": "Capacitor plugin for native iOS and Android tab bars",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACM-VIT/capacitor-native-tab.git"
  },
  "homepage": "https://github.com/ACM-VIT/capacitor-native-tab",
  "bugs": {
    "url": "https://github.com/ACM-VIT/capacitor-native-tab/issues"
  },
  "files": [
    "android/src/main/",
    "android/src/main/res/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "THIRD_PARTY_NOTICES.md",
    "*.podspec"
  ],
  "author": "ACM-VIT",
  "license": "MIT",
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "tabs",
    "android",
    "jetpack-compose",
    "ios",
    "swiftui",
    "material3"
  ],
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && rollup -c",
    "clean": "rimraf ./dist",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "watch": "tsc --watch -p tsconfig.json"
  }
}
